// MeshOp3D Windows resource file.
// Embeds the application icon into the .exe so that Explorer, the taskbar,
// and Alt+Tab display the correct icon without a separate .ico lookup.
//
// The path is relative to this .rc file (assets/). CMake/rc.exe resolves it
// from the source directory where the file lives.
IDI_ICON1 ICON "mop3d-icon.ico"
